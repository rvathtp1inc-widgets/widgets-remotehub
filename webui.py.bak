from fastapi import FastAPI, Form
from fastapi.responses import HTMLResponse, RedirectResponse
import json
import requests
from urllib.parse import quote

CFG_PATH = "config.json"

def load_cfg():
    with open(CFG_PATH, "r") as f:
        return json.load(f)

def save_cfg(cfg: dict):
    with open(CFG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)

def agent_client(cfg):
    base = cfg["host_agent"]["base_url"].rstrip("/")
    headers = {"X-Widgets-Token": cfg["host_agent"]["token"]}
    return base, headers

def agent_get(cfg, path):
    base, headers = agent_client(cfg)
    r = requests.get(f"{base}{path}", headers=headers, timeout=6)
    r.raise_for_status()
    return r.json()

def agent_post(cfg, path, body):
    base, headers = agent_client(cfg)
    r = requests.post(f"{base}{path}", headers=headers, json=body, timeout=8)
    r.raise_for_status()
    return r.json()

app = FastAPI()

@app.get("/", response_class=HTMLResponse)
def index():
    cfg = load_cfg()
    zones = cfg.get("zones", {})

    # health
    health = {"ok": False}
    health_err = None
    try:
        health = agent_get(cfg, "/health")
    except Exception as e:
        health_err = str(e)

    rows = []
    for zid, zcfg in zones.items():
        st = {}
        err = None
        try:
            st = agent_get(cfg, f"/zones/{zid}/status")
        except Exception as e:
            err = str(e)

        active = st.get("zone_active", "?") if not err else "ERR"
        mute = st.get("mute", "?") if not err else "ERR"
        vol = st.get("volume", "?") if not err else "ERR"
        svc = st.get("active_service", "") if not err else ""

        rows.append(f"""
        <tr>
          <td><a href="/zone/{zid}">{zcfg.get("display_name", zid)}</a></td>
          <td>{active}</td>
          <td>{mute}</td>
          <td>{vol}</td>
          <td style="max-width:420px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{svc}</td>
          <td>
            <a href="/action/{zid}/power">Power</a> |
            <a href="/action/{zid}/mute">Mute</a> |
            <a href="/action/{zid}/vu">Vol+</a> |
            <a href="/action/{zid}/vd">Vol-</a>
          </td>
        </tr>
        """)

    health_line = f"Host Agent Health: {health}" if not health_err else f"Host Agent Health ERROR: {health_err}"

    return f"""
    <html>
    <head><title>Widgets Remote Hub</title></head>
    <body>
      <h1>Widgets Remote Hub</h1>
      <p>{health_line}</p>
      <p><a href="/setup">Setup</a></p>
      <table border="1" cellpadding="6">
        <tr>
          <th>Zone</th><th>Active</th><th>Muted</th><th>Vol</th><th>Active Service</th><th>Actions</th>
        </tr>
        {''.join(rows)}
      </table>
    </body>
    </html>
    """

@app.get("/setup", response_class=HTMLResponse)
def setup():
    cfg = load_cfg()
    zones_cfg = cfg.get("zones", {})

    available = []
    err = None
    try:
        available = agent_get(cfg, "/savant/userzones").get("zones", [])
    except Exception as e:
        err = str(e)

    existing_ids = set(zones_cfg.keys())
    # suggested ids: snake-ish
    def to_id(name: str) -> str:
        return name.strip().lower().replace(" ", "_").replace("-", "_")

    options = ""
    for z in available:
        zid = to_id(z)
        mark = " (already added)" if zid in existing_ids else ""
        options += f'<option value="{z}">{z}{mark}</option>'

    err_html = f"<p style='color:red;'>Discovery error: {err}</p>" if err else ""

    return f"""
    <html><head><title>Setup</title></head><body>
      <h1>Setup</h1>
      <p><a href="/">Back</a></p>
      {err_html}
      <h2>Add Zone</h2>
      <form method="post" action="/save_zone">
        <label>Savant Zone Name:</label><br/>
        <select name="savant_zone_name">{options}</select><br/><br/>
        <label>Zone ID (used in URLs):</label><br/>
        <input name="zone_id" placeholder="e.g. se_living"/><br/><br/>
        <label>Display Name:</label><br/>
        <input name="display_name" placeholder="e.g. SE Living"/><br/><br/>
        <button type="submit">Add / Update Zone</button>
      </form>
      <h2>Existing Zones</h2>
      <ul>
        {''.join([f'<li><a href="/zone/{zid}">{zcfg.get("display_name", zid)}</a></li>' for zid, zcfg in zones_cfg.items()])}
      </ul>
    </body></html>
    """

@app.post("/save_zone")
def save_zone(
    savant_zone_name: str = Form(...),
    zone_id: str = Form(...),
    display_name: str = Form(...)
):
    cfg = load_cfg()
    if "zones" not in cfg:
        cfg["zones"] = {}
    cfg["zones"][zone_id] = {
        "display_name": display_name,
        "savant_zone_name": savant_zone_name,
        "service_on_token": "",
        "power_off_token": f"{savant_zone_name}-----PowerOff"
    }
    save_cfg(cfg)
    return RedirectResponse(url=f"/zone/{zone_id}", status_code=303)

@app.get("/zone/{zone_id}", response_class=HTMLResponse)
def zone_page(zone_id: str):
    cfg = load_cfg()
    z = cfg.get("zones", {}).get(zone_id)
    if not z:
        return HTMLResponse(f"<h1>Unknown zone {zone_id}</h1><p><a href='/setup'>Setup</a></p>", status_code=404)

    savant_zone = z.get("savant_zone_name", "")

    services = []
    err = None
    try:
        services = agent_get(cfg, f"/savant/services?zone={quote(savant_zone)}").get("services", [])
    except Exception as e:
        err = str(e)

    svc_opts = "".join([f'<option value="{s}">{s}</option>' for s in services])
    err_html = f"<p style='color:red;'>Service discovery error: {err}</p>" if err else ""

    return f"""
    <html><head><title>{z.get("display_name", zone_id)}</title></head><body>
      <h1>{z.get("display_name", zone_id)}</h1>
      <p><a href="/">Back</a> | <a href="/setup">Setup</a></p>

      <h2>Saved Tokens</h2>
      <p><b>PowerOff token:</b> {z.get("power_off_token","")}</p>
      <p><b>ServiceOn token:</b> {z.get("service_on_token","")}</p>

      <h2>Test</h2>
      <form method="post" action="/test_token">
        <input type="hidden" name="zone_id" value="{zone_id}"/>
        <button name="which" value="poweroff" type="submit">Test PowerOff</button>
        <button name="which" value="serviceon" type="submit">Test ServiceOn</button>
      </form>

      <h2>Set ServiceOn Token (Option B)</h2>
      {err_html}
      <form method="post" action="/save_tokens">
        <input type="hidden" name="zone_id" value="{zone_id}"/>
        <label>Pick a service string (helper only):</label><br/>
        <select name="service_pick">{svc_opts}</select><br/><br/>
        <label>ServiceOn token (paste exact servicerequestcommand token):</label><br/>
        <input name="service_on_token" style="width:900px;" value="{z.get("service_on_token","")}" placeholder="{savant_zone}-Sonos-Sonos_media-1-SVC_AV_SONOS-PowerOn"/><br/><br/>
        <label>PowerOff token:</label><br/>
        <input name="power_off_token" style="width:900px;" value="{z.get("power_off_token","")}" /><br/><br/>
        <button type="submit">Save Tokens</button>
      </form>
    </body></html>
    """

@app.post("/save_tokens")
def save_tokens(
    zone_id: str = Form(...),
    service_on_token: str = Form(...),
    power_off_token: str = Form(...),
    service_pick: str = Form(None)
):
    cfg = load_cfg()
    z = cfg.get("zones", {}).get(zone_id)
    if not z:
        return RedirectResponse(url="/setup", status_code=303)
    z["service_on_token"] = service_on_token.strip()
    z["power_off_token"] = power_off_token.strip()
    cfg["zones"][zone_id] = z
    save_cfg(cfg)
    return RedirectResponse(url=f"/zone/{zone_id}", status_code=303)

@app.post("/test_token", response_class=HTMLResponse)
def test_token(zone_id: str = Form(...), which: str = Form(...)):
    cfg = load_cfg()
    z = cfg.get("zones", {}).get(zone_id, {})
    token = z.get("power_off_token") if which == "poweroff" else z.get("service_on_token")

    if not token:
        return HTMLResponse(f"<p>Token is blank. Save it first.</p><p><a href='/zone/{zone_id}'>Back</a></p>", status_code=400)

    try:
        res = agent_post(cfg, "/savant/testtoken", {"token": token})
        return HTMLResponse(f"<pre>{json.dumps(res, indent=2)}</pre><p><a href='/zone/{zone_id}'>Back</a></p>")
    except Exception as e:
        return HTMLResponse(f"<p style='color:red;'>Error: {e}</p><p><a href='/zone/{zone_id}'>Back</a></p>", status_code=500)

@app.get("/action/{zone_id}/{cmd}")
def do_action(zone_id: str, cmd: str):
    cfg = load_cfg()
    z = cfg.get("zones", {}).get(zone_id)
    if not z:
        return {"ok": False, "error": "unknown zone"}

    # Strategy B toggle using tokens stored in config (Option B)
    if cmd == "power":
        st = agent_get(cfg, f"/zones/{zone_id}/status")
        zone_active = str(st.get("zone_active", "0")) == "1"
        token = z["power_off_token"] if zone_active else z["service_on_token"]
        if not token:
            return {"ok": False, "error": "missing token"}
        agent_post(cfg, "/savant/testtoken", {"token": token})
    elif cmd == "mute":
        st = agent_get(cfg, f"/zones/{zone_id}/status")
        is_muted = str(st.get("mute", "0")) == "1"
        action = "mute_off" if is_muted else "mute_on"
        agent_post(cfg, f"/zones/{zone_id}/action", {"action": action})
    elif cmd == "vu":
        agent_post(cfg, f"/zones/{zone_id}/action", {"action": "vol_up"})
    elif cmd == "vd":
        agent_post(cfg, f"/zones/{zone_id}/action", {"action": "vol_down"})

    return {"ok": True}
